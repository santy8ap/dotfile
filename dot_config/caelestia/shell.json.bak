{
    "appearance": {
        "transparency": {
            "enabled": true
        }
    },
    "launcher": {
        "actionPrefix": ".",
        "showOnHover": true,
        "useFuzzy": {
            "apps": false,
            "wallpapers": false
        }
    },
    "notifs": {
        "openExpanded": true
    },
    "paths": {
        "wallpaperDir": "/home/santy/Imágenes/Wallpapers"
    },
    "services": {
        "defaultPlayer": "Mozilla firefox",
        "weatherUnits": "Celsius"
    },
    "sidebar": {
        "dragThreshold": 90
    },
    "utilities": {
        "quickToggles": [
            {
                "enabled": true,
                "id": "wifi"
            },
            {
                "enabled": true,
                "id": "bluetooth"
            },
            {
                "enabled": true,
