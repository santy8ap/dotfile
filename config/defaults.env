# ---------------------------------------------------------------------------
# defaults.env — valores predeterminados del instalador.
#
# TODO usa la forma  VAR="${VAR:-valor}"  para que se pueda sobrescribir desde:
#   1. el entorno   (DOTFILE_TIER=core ./install.sh)
#   2. config/host.<tu-hostname>.env   (por máquina, NO se versiona)
#   3. config/host.env                 (manual, NO se versiona)
#   4. banderas de install.sh          (--core-only, --no-system, ...)
#
# Para ver todos los valores activos:  ./install.sh --show-config
# ---------------------------------------------------------------------------

# === Qué instalar ==========================================================
# core  = solo packages/nucleo.txt (lo mínimo para tener el escritorio)
# full  = núcleo + oficiales + AUR (predeterminado)
DOTFILE_TIER="${DOTFILE_TIER:-full}"

# Listas extra a procesar además de las anteriores (separadas por espacio).
DOTFILE_EXTRA_LISTS="${DOTFILE_EXTRA_LISTS:-}"

# === Repos / fuentes =======================================================
DOTFILE_REPO_URL="${DOTFILE_REPO_URL:-https://github.com/santy8ap/dotfile.git}"
DOTFILE_REPO_BRANCH="${DOTFILE_REPO_BRANCH:-main}"

# Actualizar todo el sistema antes de instalar (pacman -Syu).
# En Arch es la práctica correcta: nunca instalar tras un `pacman -Sy` suelto.
DOTFILE_SYSUPGRADE="${DOTFILE_SYSUPGRADE:-yes}"

# Reflejos: usar cachyos-rate-mirrors para ordenar los espejos más rápidos.
DOTFILE_RATE_MIRRORS="${DOTFILE_RATE_MIRRORS:-yes}"

# Descargas paralelas de pacman.
DOTFILE_PARALLEL_DOWNLOADS="${DOTFILE_PARALLEL_DOWNLOADS:-8}"

# === Base upstream (antes de tus personalizaciones) ========================
# `caelestia install` (caelestia-cli) instala dotfiles/paquetes según el
# manifest oficial actual. "skip" solo si ya tienes la base instalada.
DOTFILE_UPSTREAM_MODE="${DOTFILE_UPSTREAM_MODE:-install}"
# Tu navegador es Zen. No dejar que el manifest upstream instale Firefox.
# Consulta `caelestia install --help` antes de cambiar los componentes.
DOTFILE_UPSTREAM_DISABLE_COMPONENTS="${DOTFILE_UPSTREAM_DISABLE_COMPONENTS:-firefox}"

# === Dotfiles ==============================================================
# Aplicar el estado de chezmoi (home/) sobre $HOME.
DOTFILE_APPLY_DOTFILES="${DOTFILE_APPLY_DOTFILES:-yes}"

# Modo de chezmoi al aplicar: apply | diff (solo muestra) | none
DOTFILE_CHEZMOI_MODE="${DOTFILE_CHEZMOI_MODE:-apply}"

# Carpeta de fondos de pantalla (la usan caelestia y rotar-fondo).
DOTFILE_WALLPAPER_DIR="${DOTFILE_WALLPAPER_DIR:-${HOME}/Imágenes/Wallpapers}"

# === Sistema (requiere sudo) ===============================================
# Tocar /etc, servicios del sistema, grupos, ufw, locale, timezone.
DOTFILE_SYSTEM="${DOTFILE_SYSTEM:-yes}"

# Aplicar los archivos de system/etc/ sobre /etc (siempre con respaldo previo).
DOTFILE_APPLY_ETC="${DOTFILE_APPLY_ETC:-no}"

# Zona horaria y teclado de consola. Vacío = no tocar.
DOTFILE_TIMEZONE="${DOTFILE_TIMEZONE:-America/Bogota}"
DOTFILE_KEYMAP="${DOTFILE_KEYMAP:-latam}"
# Locale observado en el Lenovo original. El instalador habilita locale.gen con respaldo.
# Cambia esto en config/host.<hostname>.env si el destino usa otro idioma.
DOTFILE_LOCALE="${DOTFILE_LOCALE:-es_MX.UTF-8}"

# Firewall ufw.
DOTFILE_UFW="${DOTFILE_UFW:-no}"
DOTFILE_UFW_ALLOW_LOCALSEND="${DOTFILE_UFW_ALLOW_LOCALSEND:-yes}"
DOTFILE_UFW_ALLOW_SSH="${DOTFILE_UFW_ALLOW_SSH:-no}"

# /etc/sudoers.d para que `server_mode`/`normal_mode` de fish no pidan clave.
DOTFILE_SUDOERS_CPUPOWER="${DOTFILE_SUDOERS_CPUPOWER:-no}"

# Añadir el hook `plymouth` a mkinitcpio y regenerar las imágenes de arranque.
# En apagado por defecto: tocar mkinitcpio mal puede dejar la PC sin arrancar.
DOTFILE_PLYMOUTH_MKINITCPIO="${DOTFILE_PLYMOUTH_MKINITCPIO:-no}"

# `sudo chwd` (detección de hardware de CachyOS) tras instalar paquetes.
DOTFILE_CHWD="${DOTFILE_CHWD:-no}"

# `loginctl enable-linger`: mantiene servicios de usuario vivos sin sesión.
DOTFILE_ENABLE_LINGER="${DOTFILE_ENABLE_LINGER:-no}"

# === Servicios =============================================================
# Servicios del sistema a habilitar (se ignoran los que no existan).
DOTFILE_SYSTEM_SERVICES="${DOTFILE_SYSTEM_SERVICES:-
NetworkManager
bluetooth
cups
systemd-timesyncd
}"

# Temporizadores del sistema a habilitar.
DOTFILE_SYSTEM_TIMERS="${DOTFILE_SYSTEM_TIMERS:-
fstrim.timer
plocate-updatedb.timer
}"

# Unidades de usuario a habilitar (las que aporte este repo).
DOTFILE_USER_SERVICES="${DOTFILE_USER_SERVICES:-
rotar-fondo.timer
}"

# Grupos de usuario a agregar (se ignoran los que no existan en el sistema).
DOTFILE_USER_GROUPS="${DOTFILE_USER_GROUPS:-
video
audio
render
realtime
}"

# === Apariencia ============================================================
DOTFILE_GTK_THEME="${DOTFILE_GTK_THEME:-adw-gtk3-dark}"
DOTFILE_ICON_THEME="${DOTFILE_ICON_THEME:-Papirus-Dark}"
# Debe coincidir con cursorTheme/cursorSize de home/dot_config/hypr/variables.lua
DOTFILE_CURSOR_THEME="${DOTFILE_CURSOR_THEME:-Adwaita}"
DOTFILE_CURSOR_SIZE="${DOTFILE_CURSOR_SIZE:-24}"
DOTFILE_COLOR_SCHEME="${DOTFILE_COLOR_SCHEME:-prefer-dark}"
DOTFILE_FONT_NAME="${DOTFILE_FONT_NAME:-Adwaita Sans 11}"
DOTFILE_FONT_MONO="${DOTFILE_FONT_MONO:-Adwaita Mono 11}"
DOTFILE_PAPIRUS_COLOR="${DOTFILE_PAPIRUS_COLOR:-}"  # vacío = autodetectar/omitir

# === Comportamiento del instalador =========================================
DOTFILE_BACKUP="${DOTFILE_BACKUP:-yes}"
DOTFILE_BACKUP_KEEP="${DOTFILE_BACKUP_KEEP:-5}"
DOTFILE_DRY_RUN="${DOTFILE_DRY_RUN:-no}"
DOTFILE_YES="${DOTFILE_YES:-no}"
DOTFILE_FORCE="${DOTFILE_FORCE:-no}"
DOTFILE_VERBOSE="${DOTFILE_VERBOSE:-no}"
DOTFILE_KEEP_GOING="${DOTFILE_KEEP_GOING:-no}"
DOTFILE_WITH_IGNORED="${DOTFILE_WITH_IGNORED:-no}"
DOTFILE_LOG_FILE="${DOTFILE_LOG_FILE:-}"
DOTFILE_STATE_DIR="${DOTFILE_STATE_DIR:-}"
