root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{sh,bash}]
indent_size = 4
max_line_length = 100

[*.{lua,conf,ini,toml,json,yml,yaml}]
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2

[*.{service,timer,socket,mount,path}]
indent_size = 4

[*.fish]
indent_size = 4

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[.{gitignore,chezmoiignore,chezmoiroot,editorconfig,shellcheckrc}]
indent_size = 4
